# kor-travel-geo 운영(prod) 환경값 — 예시(placeholder)
#
# 실제 도메인/비밀값은 이 파일이 아니라 gitignored `.env.prod`(또는 배포 노드의
# `/etc/kor-travel-geo/app.env`)에 둔다. 이 `.example`만 git에 추적되며, 실제 값은
# 절대 커밋하지 않는다(외부 노출 금지).
#
# 두 배포 경로가 같은 파일을 공유한다:
#   - deploy_app.py:  실제 값 파일을 노드의 `/etc/kor-travel-geo/app.env`로 두고
#                     `--remote-env-file`로 주입(docker `--env-file`).
#   - docker_app.sh:  `KTG_ENV_FILE=.env.prod scripts/docker_app.sh up`
#
# 형식 규칙(docker `--env-file` 호환):
#   - 전체 줄 주석(`#`)만 허용. 값 뒤 inline 주석 금지.
#   - JSON 리스트는 따옴표째 그대로: KTG_API_CORS_ORIGINS=["https://..."]

# --- 도메인 (리버스 프록시가 TLS 종단) ---
# UI 서버사이드 프록시 → API. 컨테이너가 같은 docker 네트워크에 co-located면
# http://kor-travel-geo-api:12501 이 더 빠르다(공개 도메인은 hairpin).
KTG_API_INTERNAL_URL=https://<geo-api-host>
# API CORS 허용 origin. UI는 same-origin `/api/proxy`를 쓰므로 보통 선택적이지만,
# 브라우저가 API를 직접 호출하는 경우를 대비해 UI 공개 origin을 넣어 둔다.
KTG_API_CORS_ORIGINS=["https://<geo-ui-host>"]
NEXT_PUBLIC_API_BASE_URL=/api/proxy

# --- RustFS / S3 (prod) ---
KTG_RUSTFS_ENABLED=true
KTG_RUSTFS_ENDPOINT_URL=https://<s3-api-host>
KTG_RUSTFS_BUCKET=kor-travel-geo
KTG_RUSTFS_PREFIX=kor-travel-geo
KTG_RUSTFS_REGION=us-east-1
# RustFS console(운영자 UI, 앱 변수 아님): https://<s3-console-host>

# --- 운영 기본 ---
KTG_GEOIP_GATE_MODE=strict
# admin 프록시 신뢰 CIDR — 운영(Manager compose)은 loopback만(127.0.0.1/32,::1/128). 소비자 호스트(예: n150 192.168.1.14)를
# 넣지 않는다: 넣으면 admin 프록시 면제가 소비자에게 열려 공개 키 정책이 무의미해진다(ADR-070 D1).
KTG_ADMIN_TRUSTED_PROXY_CIDRS=<reverse-proxy-cidr>
# TLS 종단 프록시가 X-Forwarded-Proto=https를 주입하지 못하는 경우에도 로그인 CSRF
# 검사가 공개 HTTPS origin을 허용하도록, 실제 UI 공개 origin을 쉼표로 명시한다.
KTG_UI_PUBLIC_ORIGINS=https://<geo-ui-host>

# --- Dagster observability (T-290: 백엔드 내부 target / 브라우저 공개 도메인 분리) ---
# 백엔드 GraphQL 관측 target(내부 loopback, SSRF allowlist 적용). 브라우저에 노출되지 않는다.
# 12502는 geo 독립 Dagster webserver 시절(T-290)·standalone 스택 값이자 앱 기본값이다. 운영은 공용 Dagster plane(T-324)이라
# Manager compose가 그 호스트 plane webserver의 loopback URL을 주입한다(2026-10 기준 n150·odroid 모두 127.0.0.1:11002 —
# 값의 정본은 Manager). 이 파일 값은 standalone 실행용.
KTG_DAGSTER_URL=http://127.0.0.1:12502
# admin UI iframe/링크에 반환하는 브라우저 노출용 공개 도메인. 라우터가 TLS 종단 후 Dagster webserver로
# 리버스 프록시한다(concierge *.digitie.mywire.org와 같은 패턴). 운영은 geo가 붙은 **호스트의 공용 plane** 공개 host다
# (2026-10-15 odroid = dagster-sub. host, n150 = dagster. host — 정본은 Manager compose·HAProxy). 공개값
# (비밀 아님)이라 커밋 가능. 비우면 KTG_DAGSTER_URL로 폴백하며 백엔드 GraphQL엔 사용하지 않는다.
KTG_DAGSTER_PUBLIC_URL=https://geo-dagster.example.org
KTG_DAGSTER_ADMIN_API_URL=http://kor-travel-geo-api:12501
# 백엔드 GraphQL 대상 host allowlist(내부만). 공개 도메인은 여기 넣지 않는다(브라우저 echo 전용).
KTG_DAGSTER_ALLOWED_HOSTS=127.0.0.1,kor-travel-geo-dagster

# --- 비밀값: 배포 호스트/노드에서만 채운다(커밋 금지) ---
# geo PostgreSQL은 T-308(2026-09)부터 공용 제어 평면 instance host 포트 11000이다(manager ADR-45;
# 옛 전용 instance 12500은 2026-09-28 은퇴). 앱 role은 kor_travel_geo_app(NOSUPERUSER/NOCREATEDB).
# manager compose(host network)에서는 <db-host>=127.0.0.1; deploy_app.py 같은 bridge 네트워크
# 실행이면 컨테이너 안 127.0.0.1은 자기 자신이므로 host에서 닿는 주소를 넣는다.
# KTG_PG_DSN=postgresql+psycopg://kor_travel_geo_app:<pass>@<db-host>:11000/kor_travel_geo
# 공개 API 키: DB ops.public_api_keys에 active 키가 하나도 없을 때만 이 VWorld 키가 유일한 유효 키다(폴백). 둘 다 비면
# 모든 공개 키 요청이 거부된다(public_api_key.py). compose의 ${X:-}는 빈 문자열을 주므로 '설정 안 함'과 같다.
# KTG_VWORLD_API_KEY=<key>
# KTG_ADMIN_PROXY_SECRET=<random-shared-secret>
# KTG_RUSTFS_ACCESS_KEY=<key>
# KTG_RUSTFS_SECRET_KEY=<key>

# --- 원천 파일(full load) ---
# full_load_batch payload 경로는 컨테이너 /app/data/source/... 절대경로가 계약이다. 호스트 기본 경로는
# /home/digitie/kor-travel-geo-data/source(bind :ro — docs/deploy/docker-compose.geo-source-vol.yml, Manager 상시 bind는 ADR-070 D3-2).
# 풀로드 라우팅 env(KOR_TRAVEL_GEO_DAGSTER_EXECUTED_JOB_KINDS)는 T-290k 이후 없다 — 모든 실행이 Dagster로 간다.
